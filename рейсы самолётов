CREATE TABLE Passengers(
	Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
	[FirtsName] NVARCHAR(100) NOT NULL,
	[LastName] NVARCHAR(100) NOT NULL,
	[Age] CHAR(3) NOT NULL,
);

CREATE TABLE City (
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [CityName] VARCHAR(50) NOT NULL UNIQUE
);


CREATE TABLE Flights (
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [FlightNumber] VARCHAR(10) NOT NULL,
    [FlightCompany] NVARCHAR(50) NOT NULL,
    [DepartureCityId] INT NOT NULL,
    [ArrivalCityId] INT NOT NULL,
    [DepartureDate] DATE NOT NULL,
    [DepartureTime] TIME NOT NULL,
    [ArrivalDate] DATE NOT NULL,
    [ArrivalTime] TIME NOT NULL,
    FOREIGN KEY (DepartureCityId) REFERENCES City(Id),
    FOREIGN KEY (ArrivalCityId) REFERENCES City(Id)
);




CREATE TABLE Tickets (
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [FlightId] INT NOT NULL,
    [PassengerId] INT NOT NULL,
    [SeatNumber] VARCHAR(10) NOT NULL,
    [Class] VARCHAR(20) NOT NULL CHECK (Class IN ('economy', 'business')),
    [Price] DECIMAL(10,2) NOT NULL,
    FOREIGN KEY (FlightId) REFERENCES Flights(Id),
    FOREIGN KEY (PassengerId) REFERENCES Passengers(Id)
);



