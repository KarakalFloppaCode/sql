--1

SELECT f.*, c.CityName AS ArrivalCity
FROM Flights f
JOIN City c ON f.ArrivalCityId = c.Id
WHERE c.CityName = 'Москва' AND f.DepartureDate = '2000-04-12'
ORDER BY f.DepartureTime;



--2

SELECT TOP 1 *,
    DATEDIFF(MINUTE,
        CAST(DepartureDate AS DATETIME) + CAST(DepartureTime AS DATETIME),
        CAST(ArrivalDate AS DATETIME) + CAST(ArrivalTime AS DATETIME)
    ) AS DurationMinutes
FROM Flights
ORDER BY DurationMinutes DESC;

--3

SELECT *,
    DATEDIFF(MINUTE,
        CAST(DepartureDate AS DATETIME) + CAST(DepartureTime AS DATETIME),
        CAST(ArrivalDate AS DATETIME) + CAST(ArrivalTime AS DATETIME)
    ) AS DurationMinutes
FROM Flights
WHERE DATEDIFF(MINUTE,
    CAST(DepartureDate AS DATETIME) + CAST(DepartureTime AS DATETIME),
    CAST(ArrivalDate AS DATETIME) + CAST(ArrivalTime AS DATETIME)) > 120;

--4

SELECT c.CityName, COUNT(*) AS TotalFlights
FROM Flights f
JOIN City c ON f.ArrivalCityId = c.Id
GROUP BY c.CityName;

--5

SELECT TOP 1 c.CityName, COUNT(*) AS TotalFlights
FROM Flights f
JOIN City c ON f.ArrivalCityId = c.Id
GROUP BY c.CityName
ORDER BY TotalFlights DESC;

--6

SELECT c.CityName, COUNT(*) AS FlightsPerCity
FROM Flights f
JOIN City c ON f.ArrivalCityId = c.Id
WHERE MONTH(f.DepartureDate) = 4 AND YEAR(f.DepartureDate) = 2000
GROUP BY c.CityName
UNION ALL
SELECT 'Total', COUNT(*)
FROM Flights
WHERE MONTH(DepartureDate) = 4 AND YEAR(DepartureDate) = 2000;

--7

SELECT f.*
FROM Flights f
LEFT JOIN Tickets t ON f.Id = t.FlightId AND t.Class = 'business'
WHERE f.DepartureDate = '2000-04-12'
GROUP BY f.Id, f.FlightNumber, f.FlightCompany, f.DepartureCityId, f.ArrivalCityId,
         f.DepartureDate, f.DepartureTime, f.ArrivalDate, f.ArrivalTime
HAVING COUNT(t.Id) < 10;

--8

SELECT COUNT(t.Id) AS TotalTickets, SUM(t.Price) AS TotalRevenue
FROM Tickets t
JOIN Flights f ON t.FlightId = f.Id
WHERE f.DepartureDate = '2000-04-12';


--9

SELECT f.FlightNumber, f.DepartureDate, COUNT(t.Id) AS SoldTickets
FROM Flights f
LEFT JOIN Tickets t ON f.Id = t.FlightId
WHERE f.DepartureDate = '2000-04-13'
GROUP BY f.FlightNumber, f.DepartureDate;

--10

SELECT f.FlightNumber, c.CityName AS ArrivalCity
FROM Flights f
JOIN City c ON f.ArrivalCityId = c.Id
WHERE f.DepartureCityId = 1;










