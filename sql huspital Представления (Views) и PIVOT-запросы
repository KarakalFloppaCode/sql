--2
CREATE VIEW dbo.v_DoctorExamStats
AS
SELECT
    d.Id AS DoctorId,
    d.Surname,
    d.[Name],
    COUNT(de.Id) AS ExamsCount,
    COUNT(DISTINCT de.DiseaseId) AS DiseasesCount
FROM Doctors d
JOIN DoctorsExaminations de ON de.DoctorId = d.Id
JOIN Examinations e ON e.Id = de.ExaminationId
GROUP BY d.Id, d.Surname, d.[Name];
GO

SELECT * FROM dbo.v_DoctorExamStats;


