--1
SELECT DISTINCT lr.Name AS RoomName
FROM LectureRooms lr
JOIN Schedules s ON lr.Id = s.LectureRoomId
JOIN Lectures l ON s.LectureId = l.Id
JOIN Teachers t ON l.TeacherId = t.Id
WHERE t.Name = 'Edward' AND t.Surname = 'Hopper';

--2
SELECT DISTINCT t.Surname
FROM Assistants a
JOIN Teachers t ON a.TeacherId = t.Id
JOIN Lectures l ON t.Id = l.TeacherId
JOIN GroupsLectures gl ON l.Id = gl.LectureId
JOIN Groups g ON gl.GroupId = g.Id
WHERE g.Name = 'F505';

--3
SELECT DISTINCT s.Name AS SubjectName
FROM Subjects s
JOIN Lectures l ON s.Id = l.SubjectId
JOIN Teachers t ON l.TeacherId = t.Id
JOIN GroupsLectures gl ON l.Id = gl.LectureId
JOIN Groups g ON gl.GroupId = g.Id
WHERE t.Name = 'Alex' AND t.Surname = 'Carmack' AND g.Year = 5;

--4
SELECT t.Surname
FROM Teachers t
WHERE t.Id NOT IN (
    SELECT l.TeacherId
    FROM Lectures l
    JOIN Schedules s ON l.Id = s.LectureId
    WHERE s.DayOfWeek = 1);

--5
SELECT lr.Name AS RoomName, lr.Building
FROM LectureRooms lr
WHERE lr.Id NOT IN (
    SELECT s.LectureRoomId
    FROM Schedules s
    WHERE s.DayOfWeek = 3 AND s.Week = 2 AND s.Class = 3);

--6
SELECT t.Name, t.Surname
FROM Teachers t
JOIN Deans d ON t.Id = d.TeacherId
JOIN Faculties f ON d.Id = f.DeanId
WHERE f.Name = 'Computer Science'
  AND NOT EXISTS (
      SELECT 1
      FROM GroupsCurators gc
      JOIN Groups g ON gc.GroupId = g.Id
      JOIN Departments dpt ON g.DepartmentId = dpt.Id
      WHERE gc.CuratorId = t.Id AND dpt.Name = 'Software Development');

--7
SELECT DISTINCT Building
FROM (
    SELECT Building FROM Faculties
    UNION ALL
    SELECT Building FROM Departments
    UNION ALL
    SELECT Building FROM LectureRooms
) AS AllBuildings;

--8
SELECT Name, Surname
FROM (
    SELECT t.Name, t.Surname, 1 AS Priority
    FROM Teachers t
    JOIN Deans d ON t.Id = d.TeacherId
    UNION ALL
    SELECT t.Name, t.Surname, 2 AS Priority
    FROM Teachers t
    JOIN Heads h ON t.Id = h.TeacherId
    UNION ALL
    SELECT DISTINCT t.Name, t.Surname, 3 AS Priority
    FROM Teachers t
    JOIN Lectures l ON t.Id = l.TeacherId
    UNION ALL
    SELECT t.Name, t.Surname, 4 AS Priority
    FROM Teachers t
    JOIN Curators c ON t.Id = c.TeacherId
    UNION ALL
    SELECT t.Name, t.Surname, 5 AS Priority
    FROM Teachers t
    JOIN Assistants a ON t.Id = a.TeacherId
) AS Ordered
ORDER BY Priority, Name, Surname;

--9
SELECT DISTINCT s.DayOfWeek
FROM Schedules s
JOIN LectureRooms lr ON s.LectureRoomId = lr.Id
WHERE lr.Building = 1 AND lr.Name IN ('A311', 'A104');
